# dependencies
/node_modules

# next.js build output
/.next/
/out/

# production
/build

# env files — НИКОГДА не коммитить реальные ключи
.env
.env.local
.env.*.local

# содержит REMINDERS_CRON_SECRET в открытом виде — не коммитить
/n8n/

# misc
.DS_Store
*.pem
# ...кроме публичных корневых сертификатов НУЦ Минцифры: без них сервер не
# может проверить подлинность платёжного шлюза ВТБ и оплата не работает.
# Правило выше отсекло их молча — git add отработал без единого слова, в
# контейнер уехал только README рядом. Секретов в этих файлах нет, приватные
# ключи по-прежнему под запретом. См. certs/README.md.
!certs/russian-trusted-ca.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# typescript
*.tsbuildinfo
next-env.d.ts
